# ============================================================
# LLM Play Chinese Chess - files excluded from the repository
# ============================================================

# --- Python bytecode / build artefacts ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments (recreate with `pip install -r requirements.txt`) ---
.venv/
venv/
env/
ENV/

# --- Runtime output ---
logs/
preview/
tests/real_game_state.json
tests/smoke_config.yaml

# --- Local-only development files -------------------------------------------
# The published repository ships the runtime program only. Remove the next two
# lines (then `git add tests tools`) if you want to publish them as well.
tests/
tools/

# --- Secrets: never commit a filled-in config ---
config/config.local.yaml
config/*.secret.yaml

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Scratch files left behind by tooling ---
.~*
~$*
*.tmp-*
.fold-*/
*.kimi-rollback-*.tmp
.git-backup-*/

